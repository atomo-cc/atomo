{
  "name": "atomo-crm-service",
  "version": "1.0.0",
  "description": "CRM service configuration for Atomo platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir ../.. atomo dev --service crm",
    "dev:admin": "webpack serve --config admin-ui/webpack.config.js --port 3001",
    "build": "pnpm --dir ../.. atomo build --service crm",
    "build:admin": "webpack --config admin-ui/webpack.config.js --mode production",
    "deploy": "pnpm --dir ../.. atomo deploy --service crm",
    "migrate": "pnpm --dir ../.. atomo migrate --service crm",
    "seed": "pnpm --dir ../.. atomo seed --service crm",
    "seed:sql": "psql $DATABASE_URL -f seed.sql",
    "test": "pnpm --dir ../.. atomo test --service crm",
    "generate": "pnpm --dir ../.. atomo codegen --output services/crm-service/generated"
  },
  "dependencies": {
    "@atomo/client-sdk": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tanstack/react-query": "^4.29.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.11.0",
    "html-webpack-plugin": "^5.5.0",
    "css-loader": "^6.7.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.4.0"
  },
  "atomo": {
    "service": "crm",
    "configFile": "./atomo.config.ts",
    "schemaFile": "./schema.ts",
    "pluginsDir": "./plugins",
    "workflowsDir": "./workflows",
    "adminDir": "./admin"
  }
}
