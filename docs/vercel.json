{
  "buildCommand": "cd docs && pnpm install && pnpm build",
  "outputDirectory": "docs/.vitepress/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/guide/(.*)",
      "destination": "/guide/$1"
    },
    {
      "source": "/examples/(.*)",
      "destination": "/examples/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}