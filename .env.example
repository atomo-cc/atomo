# Atomo Development Environment
DATABASE_URL=postgresql://postgres:password@localhost:5432/atomo_dev
RUST_LOG=debug

# Bootstrap admin user (created on server start if it does not already exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123

# File upload / storage
STORAGE_BACKEND=local            # local | s3 (s3 = planned)
STORAGE_LOCAL_DIR=./.atomo/media
STORAGE_MAX_FILE_SIZE=10485760   # bytes (10 MiB)
