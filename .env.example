# Atomo Development Environment
DATABASE_URL=postgresql://postgres:password@localhost:5432/atomo_dev
RUST_LOG=debug

# Bootstrap admin user (created on server start if it does not already exist).
# Seeding is create-once keyed by email: changing ADMIN_PASSWORD later is ignored
# (the server logs a WARN). To actually rotate the existing admin's password on boot,
# set ADMIN_RESET_PASSWORD=true. Changing ADMIN_EMAIL seeds an ADDITIONAL admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123
# ADMIN_RESET_PASSWORD=true   # one-shot: reset the existing admin's password from ADMIN_PASSWORD

# Self-registration (POST /auth/register). OFF by default — the route is only mounted when enabled,
# so the platform never exposes open sign-up unless you ask for it. See docs/api/auth.md.
# ATOMO_ENABLE_SELF_REGISTRATION=false
# ATOMO_SELF_REGISTRATION_ROLE=viewer       # role granted to new users
# ATOMO_SELF_REGISTRATION_TENANT=none       # none (unscoped) | per-user (own tenant) | <fixed-tenant-id>

# Realtime (ephemeral channels & presence) — WebSocket at /realtime/ws
# ATOMO_ENABLE_REALTIME=true       # set false to disable the realtime tier
# ATOMO_REALTIME_ALLOW_ANON=false  # true = allow unauthenticated WS connections (dev only)

# Multi-tenant Row-Level Security (opt-in, DB-enforced; see docs/guide/advanced/multi-tenant.md).
# OFF by default. When on, the server installs CREATE POLICY per model table at boot and the data
# layer binds atomo.tenant_id per request. Connect as a NON-superuser role for it to take effect.
# ATOMO_ENABLE_RLS=false
# ATOMO_PROJECT_ID=                # set by the control plane per instance; stamped into logs/traces

# Read cache consistency
ATOMO_CACHE_MODE=strong            # strong (default; writes evict the model's cache) | eventual
                                   #   (writes don't evict — cache stays hot through writes, reads
                                   #   may be stale up to the TTL; big read win under mixed load)
ATOMO_CACHE_TTL_SECS=60            # cache entry TTL; in eventual mode this is the max read staleness

# File upload / storage
STORAGE_BACKEND=local            # local | s3 (s3 needs the `storage-s3` cargo feature)
STORAGE_LOCAL_DIR=./.atomo/media
STORAGE_MAX_FILE_SIZE=10485760   # bytes (10 MiB)
STORAGE_PRIVATE_READS=false      # true = GET /media/{id} requires auth + matching tenant
# S3 backend (when STORAGE_BACKEND=s3). Region/creds via the standard AWS env chain.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=             # optional, e.g. http://localhost:9000 for MinIO
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Durable job queue (external-worker lease API at /jobs)
ATOMO_JOB_RECLAIM_INTERVAL=30    # seconds between sweeps that return expired job leases to the queue

# Public read (anonymous GET /public/records/{model}; see docs/api/public-read.md). Default deny:
# a model is readable only if it is listed here AND declares read: allow.public(). Per-model policy
# (no assumed status/slug convention): _FILTER_ fixes always-applied equality filters (these win
# over client params); _FIELDS_ lists the only query fields a client may filter on.
# ATOMO_PUBLIC_READ_MODELS=PublicListing
# ATOMO_PUBLIC_READ_FILTER_PublicListing=status:published
# ATOMO_PUBLIC_READ_FIELDS_PublicListing=slug,category

# Metered command primitives (expiring single-use tokens + integer-unit budget ledger; see
# docs/guide/advanced/metered-command-primitives.md). OFF by default: set true to create the
# expiring_tokens and budget_ledger tables at boot so a consumer can compose atomic metered commands.
# ATOMO_ENABLE_METERED_COMMANDS=false

# ──────────────────────────────────────────────────────────────────────────────
# Multi-project control plane (atomo_control_plane / `atomo project` CLI).
# Only needed when running many isolated projects on shared infra; see
# docs/guide/advanced/multi-project-design.md. Not used by a single atomo-server.
# ──────────────────────────────────────────────────────────────────────────────
# ATOMO_CP_DATABASE_URL=           # the control plane's OWN registry DB (never a project DB)
# ATOMO_ADMIN_DATABASE_URL=        # Postgres maintenance DB used to CREATE/DROP project DBs
# ATOMO_SECRET_STORE=ssm           # ssm (AWS SSM Parameter Store) | env (dev fallback)
# ATOMO_SERVER_IMAGE=ghcr.io/atomo-cc/atomo-server:latest  # image the Docker driver runs
# ATOMO_SCHEMA_VOLUME_ROOT=./atomo-schemas   # where pinned schemas are materialized per project
# ATOMO_PORT_BASE=4000             # base port for deterministic per-project port assignment
# ATOMO_CADDY_CONFIG=./caddy.json  # generated Caddy gateway config path
# ATOMO_CADDY_ADMIN=               # Caddy admin endpoint for hot reload, e.g. http://localhost:2019
# Operability (Phase 4):
# ATOMO_BACKUP_S3_BUCKET=          # if set, per-project pg_dump backups upload here (else local dir)
# ATOMO_BACKUP_DIR=./backups       # local backup dir when no S3 bucket
# ATOMO_RESTORE_ALLOW=             # must be truthy to permit a (destructive) restore
# ATOMO_HEALTH_TIMEOUT_MS=2000     # per-instance TCP health probe timeout
