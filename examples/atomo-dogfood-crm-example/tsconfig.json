{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["atomo/**/*.ts", "workers/**/*.ts", "generated/**/*.ts", "tests/**/*.ts", "lib/**/*.ts"]
}
