{
  "name": "@atomo-cc/client-sdk",
  "version": "0.5.7",
  "description": "TypeScript SDK for Atomo platform with full type safety",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core-types": {
      "import": "./dist/core-types.js",
      "types": "./dist/core-types.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.js",
      "types": "./dist/hooks.d.ts"
    },
    "./realtime": {
      "import": "./dist/realtime.js",
      "types": "./dist/realtime.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"*.ts\"",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "atomo",
    "typescript",
    "sdk",
    "graphql",
    "client",
    "type-safe",
    "backend",
    "realtime",
    "self-hosted",
    "firebase-alternative",
    "event-sourcing"
  ],
  "author": "Atomo Team",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atomo-cc/atomo.git",
    "directory": "packages/atomo-client-sdk"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
