{
  "name": "@atomo/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Atomo Content Core - The Next-Generation Content Management Platform",
  "scripts": {
    "dev:admin": "pnpm --filter atomo-admin-ui dev", 
    "dev:service": "atomo dev",
    "build:core": "cargo build --workspace --release",
    "build:all": "pnpm build:core && pnpm --filter \"./packages/*\" build",
    "atomo": "cargo run -p atomo_cli --",
    "test": "cargo test --workspace && pnpm --filter \"./packages/*\" test",
    "format": "cargo fmt --all && pnpm --filter \"./packages/*\" format",
    "lint": "cargo clippy --workspace -- -D warnings && pnpm --filter \"./packages/*\" lint",
    "clean": "cargo clean && pnpm --filter \"./packages/*\" clean"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/atomo-org/atomo.git"
  },
  "author": "Atomo Team",
  "license": "AGPL-3.0-or-later"
}
