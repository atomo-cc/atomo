# Keep the build context small and the image clean. The server build needs only
# the Cargo workspace (crates/ + Cargo.{toml,lock}); everything below is either
# huge, host-specific, or irrelevant to compiling atomo-server.
target/
**/target/
node_modules/
**/node_modules/
**/dist/
.git/
.github/
*.log
.env
.env.*
!.env.example
# docs/templates are not needed by either build stage. packages/ IS needed —
# the admin-builder stage compiles the Admin UI SPA from packages/atomo-admin-ui.
docs/
templates/
