# Keep the build context small and the image clean. The server build needs only
# the Cargo workspace (crates/ + Cargo.{toml,lock}); everything below is either
# huge, host-specific, or irrelevant to compiling atomo-server.
target/
**/target/
node_modules/
**/node_modules/
**/dist/
.git/
.github/
*.log
.env
.env.*
!.env.example
# Not needed to compile atomo-server (Cargo workspace only — the JS/docs trees
# are irrelevant now that the image bundles no admin UI).
packages/
services/
docs/
templates/
