# Keep the build context small and the image clean. The server build needs only
# the Cargo workspace (crates/ + Cargo.{toml,lock}); everything below is either
# huge, host-specific, or irrelevant to compiling atomo-server.
target/
**/target/
node_modules/
**/node_modules/
**/dist/
.git/
.github/
*.log
.env
.env.*
!.env.example
# packages/ IS needed — the admin-builder stage builds the generic Admin UI from
# packages/atomo-admin-ui. services/ stays out: the admin is service-agnostic, so
# the build must not depend on any service's source. docs/templates aren't used.
services/
docs/
templates/
